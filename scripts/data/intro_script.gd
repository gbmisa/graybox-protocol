class_name IntroScript
extends RefCounted
## THE OPENING's script — Postal 4-style comic pages (ScreenIntro plays it).
## r7: "replace the intro with the animation style more similar to the intro
## of postal 4 ... I will write a better script". This is the placeholder
## script; rewrite it here, nothing else needs to change.
##
## A page is a layout and its panels, shown in order:
##   layout   "strip"  n slanted panels side by side (Postal's 4-up)
##            "splash" one panel, the whole page
##            "stack"  two wide panels, one over the other
##   hold     seconds the page stays once every panel is in (click skips)
## A panel:
##   art      an image (assets/intro/*.png — generated by tools/intro_panels.gd
##            + tools/gen/comicify.py; drop a drawn PNG in its place any time)
##   caption  narration box text ("" for none)
##   sfx      a big comic sound word over the panel ("" for none)
##   focus    where in the image the camera looks (0..1), and `push` how far
##            it creeps in over the panel's life (0 = still, 0.25 = a lot)

const ART := "res://assets/intro/%s.png"

const PAGES := [
	{"layout": "strip", "hold": 3.5, "panels": [
		{"art": "billboard", "caption": "HOLLOWAY ROAD. THE SCORE IS 412, AND FALLING.",
			"sfx": "", "focus": Vector2(0.5, 0.35), "push": 0.15},
		{"art": "school", "caption": "THE COUNCIL SOLD THE PRIMARY SCHOOL FOR A POUND.",
			"sfx": "", "focus": Vector2(0.5, 0.45), "push": 0.12},
		{"art": "annex", "caption": "NOW IT COUNTS US.",
			"sfx": "", "focus": Vector2(0.5, 0.4), "push": 0.18},
		{"art": "vandermeer", "caption": "TONIGHT DR. VANDERMEER COUNTS THE APPLAUSE.",
			"sfx": "CLAP", "focus": Vector2(0.5, 0.35), "push": 0.2},
	]},
	{"layout": "splash", "hold": 4.0, "panels": [
		{"art": "regular", "caption": "SOMEBODY HAS TO UNPLUG IT.",
			"sfx": "FZZT", "focus": Vector2(0.45, 0.45), "push": 0.12},
	]},
	{"layout": "strip", "hold": 3.0, "panels": [
		{"art": "guards", "caption": "THEY WILL BE WATCHING.", "sfx": "",
			"focus": Vector2(0.5, 0.45), "push": 0.15},
		{"art": "eyes", "caption": "SO WILL EVERYTHING ELSE.", "sfx": "",
			"focus": Vector2(0.5, 0.4), "push": 0.25},
		{"art": "consento", "caption": "SMILE. IT'S SCORED.", "sfx": "",
